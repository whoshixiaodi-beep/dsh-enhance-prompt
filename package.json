{
  "name": "dsh-enhance-prompt",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DSH plugin: adds an enhance button beside the composer that rewrites the draft into a more specific prompt using the session's own model, with undo and two enhancement modes.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whoshixiaodi-beep/dsh-enhance-prompt.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "prompt",
    "prompt-engineering"
  ],
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "prompts.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-typert-protocol": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
